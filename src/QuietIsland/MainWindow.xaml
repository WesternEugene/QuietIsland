<Window x:Class="QuietIsland.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuietIsland.Controls" Title="Quiet Island" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource Text}" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Width="744" Height="430">
  <local:RenderFrame x:Name="Root" Width="744" Height="430" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True" TextOptions.TextFormattingMode="Ideal">
    <local:RenderFrame.LayoutTransform><ScaleTransform x:Name="Scale"/></local:RenderFrame.LayoutTransform>
    <local:LiquidSurface x:Name="Fluid"/>
    <Grid x:Name="Compact" Width="156" Height="44" Cursor="Hand" VerticalAlignment="Top" HorizontalAlignment="Center" Background="Transparent">
      <Grid Margin="14,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="CompactClock" Orientation="Horizontal" VerticalAlignment="Center"><ContentControl x:Name="CompactGlyph" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed"/><TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
        <StackPanel x:Name="CompactTimer" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"><local:TimerRing x:Name="CompactTimerRing" Width="22" Height="22"/><TextBlock x:Name="CompactTimerText" FontSize="11" Margin="6,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
        <Border x:Name="CompactCoverHost" Grid.Column="2" Width="28" Height="28" CornerRadius="5" Margin="12,0,0,0" Visibility="Collapsed" Background="{DynamicResource Card}"><Grid><ContentControl x:Name="CompactCoverFallback"/><Image x:Name="CompactCover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,28,28" RadiusX="5" RadiusY="5"/></Image.Clip></Image></Grid></Border>
        <StackPanel x:Name="CompactLines" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="CompactTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock x:Name="CompactSubtitle" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="Collapsed"/></StackPanel>
        <StackPanel x:Name="CompactMeta" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><StackPanel x:Name="CompactWeatherGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"><ContentControl x:Name="CompactWeatherGlyph" Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock x:Name="CompactWeather" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></StackPanel><Border x:Name="InputBadge" CornerRadius="5" Padding="5,3" Background="{DynamicResource Card}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="InputLayout" FontSize="10" TextWrapping="NoWrap"/><TextBlock x:Name="InputCaps" FontSize="10" FontWeight="Bold" Text="CAPS" Foreground="{DynamicResource Accent}" Margin="5,0,0,0" Visibility="Collapsed"/></StackPanel></Border></StackPanel>
      </Grid>
    </Grid>
    <local:RenderFrame x:Name="Panel" Visibility="Collapsed" Width="680" Height="386" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly"><StackPanel x:Name="Nav" Orientation="Horizontal"/></ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0"><TextBlock x:Name="PanelClock" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="NoWrap"/><Button x:Name="DictationButton" ToolTip="Диктовка · Ctrl+Alt+D" Width="32" Padding="7" Margin="0,0,3,0" Background="Transparent"/><Button x:Name="PinButton" ToolTip="Закрепить открытой" Width="32" Padding="7" Margin="0,0,3,0" Background="Transparent"/><Button x:Name="CloseButton" ToolTip="Свернуть · Esc" Width="32" Padding="7" Margin="0" Background="Transparent"/></StackPanel>
      </Grid>
      <Grid Grid.Row="1" MinHeight="12"><Border x:Name="TimerNotification" Visibility="Collapsed" Background="{DynamicResource Card}" CornerRadius="10" Padding="12,7" Margin="0,8,0,8"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="TimerAgain" Content="Ещё 5 мин" Margin="10,0,5,0" Padding="9,5"/><Button x:Name="TimerDismiss" Content="Закрыть" Margin="0" Padding="9,5"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:TimerRing Width="20" Height="20" Progress="0" Margin="0,0,10,0"/><TextBlock Text="Таймер завершён" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel></Border></Grid>
      <ContentControl x:Name="Body" Grid.Row="2"/>
    </local:RenderFrame>
    <Border x:Name="ToastBanner" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="34,0,34,22" Background="#EE252525" Padding="12,7" CornerRadius="8" IsHitTestVisible="False" MaxWidth="650"><TextBlock x:Name="Status" FontSize="11" TextWrapping="Wrap"/></Border>
    <TextBlock x:Name="HotkeyLabel" Visibility="Collapsed"/>
  </local:RenderFrame>
</Window>
